APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:4200

SCHOOL_NAME="Escola Modelo"
SCHOOL_TIMEZONE=America/Fortaleza
CENTRAL_ADMIN_NAME="Administrador Central"
CENTRAL_ADMIN_EMAIL=admin@example.test
CENTRAL_ADMIN_PASSWORD=change-me
ACCESS_MINIMUM_EXIT_INTERVAL_MINUTES=5
AUTH_LOGIN_MAXIMUM_ATTEMPTS=5
AUTH_LOGIN_LOCKOUT_SECONDS=300
AUTH_ACTIVATION_EXPIRATION_HOURS=24
AUTH_PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=60
AUTH_PASSWORD_RESET_THROTTLE_SECONDS=60

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=controle_acesso
DB_USERNAME=app
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=localhost:4200,127.0.0.1:4200,localhost:8000,127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="acesso@escola.test"
MAIL_FROM_NAME="${SCHOOL_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

